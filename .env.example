APP_NAME="OPEL B2C"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default is sqlite. Production / shared env: mysql (own B2C database).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=opel_b2c
# DB_USERNAME=root
# DB_PASSWORD=

# B2B_API_URL=
# B2B_API_TOKEN=

# B2B full product list (php artisan catalog:sync-b2b, daily 02:00 IST) uses
# B2B_API_BASE_URL + /products/all with the B2B_STOCK_TOKEN below. Optional:
# B2B_PRODUCTS_TIMEOUT=120

# SMS Alert (phone OTPs). If unset, OTP is written to the log.
SMSALERT_API_KEY=
SMSALERT_SENDER=
# SMSALERT_OTP_TEXT="Your OPEL login code is {code}. It expires in 5 minutes."
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=45
# OTP_PER_IDENTIFIER_PER_HOUR=10
# OTP_PER_IP_PER_HOUR=20

# WhatsApp Cloud API (phone OTPs first via WhatsApp, SMS Alert fallback on API failure).
# Off unless WHATSAPP_OTP_ENABLED=true AND token + phone number id are set. Never commit the token.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=login_registration_otp
WHATSAPP_OTP_LANGUAGE=en
# WHATSAPP_OTP_BUTTON=true

# Firebase (Google sign-in). Service account JSON path or JSON string. Required for POST /api/v1/auth/google.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend (payment return pages)
FRONTEND_URL=http://localhost:5173

# Admin SPA (password reset links). Local default matches Vite admin port.
ADMIN_FRONTEND_URL=http://localhost:5174

# SEO v0: public storefront origin (no trailing slash) for canonical/og/sitemap URLs.
# Falls back to FRONTEND_URL. Production: https://<storefront domain>
STOREFRONT_URL=http://localhost:5173
# Optional site-wide fallback og:image (absolute http(s) URL)
SEO_DEFAULT_OG_IMAGE=
# Public /api/v1/seo payload cache in seconds (admin saves bust it)
SEO_CACHE_TTL=300

# Zoho Payments (sandbox). Live later: soid prefix zohopay, scopes ZohoPay.payments.*, API https://payments.zoho.in/api/v1
ZOHO_PAYMENT_ACCOUNT_ID=
ZOHO_PAYMENT_CLIENT_ID=
ZOHO_PAYMENT_CLIENT_SECRET=
ZOHO_PAYMENT_REDIRECT_URI="${APP_URL}/api/v1/payments/zoho/oauth/callback"
# Zoho rejects localhost and non-https return URLs. Local orders omit this until it is a public https URL.
ZOHO_PAYMENT_RETURN_URL="${FRONTEND_URL}/checkout/payment/return"
ZOHO_PAYMENT_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_PAYMENT_API_BASE=https://paymentssandbox.zoho.in/api/v1
ZOHO_PAYMENT_SOID_PREFIX=zohopaysandbox
ZOHO_PAYMENT_SCOPE=ZohoPaySandbox.payments.CREATE,ZohoPaySandbox.payments.READ


# Admin staff seed (optional). php artisan db:seed --class=AdminStaffSeeder
# Never commit real passwords. Used only when both email and password are set.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME="Admin"
SEO_ALLOW_INDEXING=true
SEO_SITEMAP_CATEGORIES=false
# Shared secret; set the SAME value as SEO_EDGE_KEY in Netlify env. Unset = per-IP limit only.
SEO_EDGE_KEY=
SEO_RATE_LIMIT=300
SEO_EDGE_RATE_LIMIT=6000

# Catalog: allow `php artisan catalog:reset-seed` (DELETE + reload of B2B catalog tables).
# Plain db:seed is always a safe upsert by fixed id. Keep false, especially in production.
CATALOG_SEED_ALLOW_RESET=false

# Zoho Books contacts: one customer per address, upserted by the unique Party Code custom field.
# Needs a refresh token with ZohoBooks.contacts.CREATE,ZohoBooks.contacts.UPDATE,ZohoBooks.contacts.READ.
# Sync stays off until all five values are set. After setting them: php artisan zoho:sync-addresses
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_REFRESH_TOKEN=
# Leave REFRESH_TOKEN empty and run `php artisan zoho:books-connect` instead; the token is then stored encrypted in the DB.
ZOHO_BOOKS_REDIRECT_URI=https://api.opeltools.com/api/v1/zoho/books/oauth/callback
ZOHO_BOOKS_PARTY_CODE_FIELD=
ZOHO_BOOKS_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_BOOKS_API_BASE=https://www.zohoapis.in/books/v3

# B2B APIs (stock lookup + order-item stock deduction). Token is secret: set on the server only.
B2B_API_BASE_URL=https://mazingbusiness.com/mazing_business_react/api/b2c
B2B_STOCK_TOKEN=
# Optional overrides; defaults are Kolkata=1, Delhi=2, Mumbai=6.
B2B_WAREHOUSE_ID_KOLKATA=
B2B_WAREHOUSE_ID_DELHI=
B2B_WAREHOUSE_ID_MUMBAI=
